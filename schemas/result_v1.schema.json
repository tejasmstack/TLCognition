        "y_px": {
          "$ref": "#/$defs/DensitogramYAxis"
        }
      },
      "required": [
        "lane_index",
        "y_px",
        "unit",
        "sampling",
        "n_valid_columns",
        "ref",
        "sha256",
        "preview"
      ],
      "title": "Densitogram",
      "type": "object"
    },

    "Densitogram": {
      "additionalProperties": false,
      "description": "The preview is non-authoritative (decimated block-mean, rounded by the\nproducer to 5 dp, for the frontend only). Nothing may be computed from it;\nthe full float32 trace behind ``ref`` is authoritative.",
      "properties": {
        "lane_index": {
          "title": "Lane Index",
          "type": "integer"
        },
        "n_valid_columns": {
          "title": "N Valid Columns",
          "type": "integer"
